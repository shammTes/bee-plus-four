<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Release builds never use the network (updates come only as a file; ML Kit models are bundled).
         Strip INTERNET / network state that libraries (e.g. ML Kit's datatransport telemetry) would merge in.
         Debug/profile keep INTERNET from their own manifests for hot reload. -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove"/>
</manifest>
