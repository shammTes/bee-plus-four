      "stem": "The solution set of 2x - 1 > x + 2 is",
      "options": {
        "A": "{x | x > 3}",
        "B": "{x | -1 < x < 2}",
        "C": "{x | x > 2}",
        "D": "{x | x > -3}",
        "E": "{x | x < 3}"
      },
      "answer": "A",
      "accepted_answers": ["A"],
      "explanation_steps": [
        "2x - 1 > x + 2 ⇒ 2x - x > 2 + 1 ⇒ x > 3.",
        "Solution set is {x | x > 3}. Answer: A."
