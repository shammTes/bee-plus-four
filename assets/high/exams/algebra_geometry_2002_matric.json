      "id": "alg-geo-2002-matric-p1-q03",
      "exam_id": "alg-geo-2002-matric",
      "part": 1,
      "number": 3,
      "type": "mcq",
      "marks": 2,
      "stem": "Which of the following is not true about the relation P = {(x, y) | x = y + 1}?",
      "options": {
        "A": "x ≥ y",
        "B": "−y ≥ −x",
        "C": "x ≤ y",
        "D": "1 ≤ y",
        "E": "None of the above."
      },
      "answer": "C",
      "accepted_answers": [
        "C"
      ],
      "explanation_steps": [
        "If x = y + 1 then x > y, so x ≥ y and −y ≥ −x are true.",
        "x ≤ y is false for every pair in P.",
        "The statement that is not true is C."
      ],
