{"grade":"G10","deck_count":14,"decks":[{"grade":"G10","subject":"MATH","unit_number":1,"title":"Relations and Functions","type":"illustrated_cards","slides":[{"n":1,"heading":"Relation","body":"Pairs elements of A with B. Not every relation is a function.","accent":"#0D9488"},{"n":2,"heading":"Function rule","body":"Each input has exactly one output.","accent":"#7C3AED"},{"n":3,"heading":"Domain and range","body":"Domain: allowed inputs. Range: actual outputs.","accent":"#0284C7"},{"n":4,"heading":"Worked idea","body":"f(x)=x²+1. Domain: all real x. f(2)=5.","accent":"#EA580C"},{"n":5,"heading":"Try this","body":"x ↦ ±√x is not a function of x≥0 (two outputs).","accent":"#DB2777"}]},{"grade":"G10","subject":"MATH","unit_number":2,"title":"Polynomial Functions","type":"illustrated_cards","slides":[{"n":1,"heading":"Degree","body":"Highest power with nonzero coefficient.","accent":"#0D9488"},{"n":2,"heading":"End behaviour","body":"Even degree, positive leading coefficient → both ends up.","accent":"#7C3AED"},{"n":3,"heading":"Factor theorem","body":"If f(a)=0 then (x−a) is a factor.","accent":"#0284C7"},{"n":4,"heading":"Worked idea","body":"x²−5x+6=(x−2)(x−3). Roots 2 and 3.","accent":"#EA580C"},{"n":5,"heading":"Try this","body":"Degree of 4x³−x+7 is 3.","accent":"#DB2777"}]},{"grade":"G10","subject":"MATH","unit_number":3,"title":"Exponential and Logarithmic Functions","type":"illustrated_cards","slides":[{"n":1,"heading":"Exponential growth","body":"y=a·bˣ with b>1 grows; 0<b<1 decays.","accent":"#0D9488"},{"n":2,"heading":"Log definition","body":"log_b a = c ⇔ b^c = a.","accent":"#7C3AED"},{"n":3,"heading":"Log laws","body":"log(xy)=log x+log y; log(x/y)=log x−log y.","accent":"#0284C7"},{"n":4,"heading":"Worked idea","body":"log₂ 32 = 5.","accent":"#EA580C"},{"n":5,"heading":"Try this","body":"log 100 + log 1 = 2.","accent":"#DB2777"}]},{"grade":"G10","subject":"MATH","unit_number":4,"title":"Trigonometry","type":"illustrated_cards","slides":[{"n":1,"heading":"Unit circle","body":"sin and cos as coordinates on radius 1.","accent":"#0D9488"},{"n":2,"heading":"SOH-CAH-TOA","body":"Right-triangle ratios still apply.","accent":"#7C3AED"},{"n":3,"heading":"Identity","body":"sin²θ+cos²θ=1.","accent":"#0284C7"},{"n":4,"heading":"Worked idea","body":"3-4-5 triangle: sin=3/5, cos=4/5.","accent":"#EA580C"},{"n":5,"heading":"Try this","body":"tanθ=sinθ/cosθ.","accent":"#DB2777"}]},{"grade":"G10","subject":"MATH","unit_number":5,"title":"Statistics","type":"illustrated_cards","slides":[{"n":1,"heading":"Mean","body":"Sum ÷ count.","accent":"#0D9488"},{"n":2,"heading":"Median","body":"Middle value when ordered.","accent":"#7C3AED"},{"n":3,"heading":"Mode","body":"Most frequent value.","accent":"#0284C7"},{"n":4,"heading":"Worked idea","body":"2,3,3,7: mean=3.75, median=3, mode=3.","accent":"#EA580C"},{"n":5,"heading":"Try this","body":"Median resists outliers better than mean.","accent":"#DB2777"}]},{"grade":"G10","subject":"PHYSICS","unit_number":1,"title":"Mechanics — Forces","type":"illustrated_cards","slides":[{"n":1,"heading":"Newton 1","body":"Net force zero → constant velocity.","accent":"#0D9488"},{"n":2,"heading":"Newton 2","body":"F=ma.","accent":"#7C3AED"},{"n":3,"heading":"Newton 3","body":"Equal and opposite forces.","accent":"#0284C7"},{"n":4,"heading":"Worked idea","body":"m=2 kg, a=3 → F=6 N.","accent":"#EA580C"},{"n":5,"heading":"Try this","body":"Net force zero ⇒ a=0.","accent":"#DB2777"}]},{"grade":"G10","subject":"PHYSICS","unit_number":2,"title":"Energy and Work","type":"illustrated_cards","slides":[{"n":1,"heading":"Work","body":"W=F·d (along displacement).","accent":"#0D9488"},{"n":2,"heading":"KE","body":"½mv².","accent":"#7C3AED"},{"n":3,"heading":"GPE","body":"mgh near Earth.","accent":"#0284C7"},{"n":4,"heading":"Worked idea","body":"m=2, v=3 → KE=9 J.","accent":"#EA580C"},{"n":5,"heading":"Try this","body":"Raise 1 kg by 2 m (g≈10): GPE≈20 J.","accent":"#DB2777"}]},{"grade":"G10","subject":"PHYSICS","unit_number":3,"title":"Waves and Sound","type":"illustrated_cards","slides":[{"n":1,"heading":"v=fλ","body":"Speed = frequency × wavelength.","accent":"#0D9488"},{"n":2,"heading":"Types","body":"Transverse vs longitudinal.","accent":"#7C3AED"},{"n":3,"heading":"Sound","body":"Needs a medium.","accent":"#0284C7"},{"n":4,"heading":"Worked idea","body":"f=50, λ=2 → v=100 m/s.","accent":"#EA580C"},{"n":5,"heading":"Try this","body":"Higher pitch → higher frequency.","accent":"#DB2777"}]},{"grade":"G10","subject":"BIOLOGY","unit_number":1,"title":"Cell Division","type":"illustrated_cards","slides":[{"n":1,"heading":"Mitosis","body":"Two identical diploid cells.","accent":"#0D9488"},{"n":2,"heading":"Meiosis","body":"Gametes with half chromosomes.","accent":"#7C3AED"},{"n":3,"heading":"Stages","body":"PMAT for mitosis.","accent":"#0284C7"},{"n":4,"heading":"Worked idea","body":"Human body 46; gametes 23.","accent":"#EA580C"},{"n":5,"heading":"Try this","body":"Crossing over in meiosis.","accent":"#DB2777"}]},{"grade":"G10","subject":"BIOLOGY","unit_number":2,"title":"Genetics","type":"illustrated_cards","slides":[{"n":1,"heading":"Gene/allele","body":"Gene unit of heredity; alleles alternatives.","accent":"#0D9488"},{"n":2,"heading":"Dominance","body":"Dominant shows in heterozygote.","accent":"#7C3AED"},{"n":3,"heading":"Punnett","body":"Predict offspring ratios.","accent":"#0284C7"},{"n":4,"heading":"Worked idea","body":"Tt×Tt → 3:1 phenotype if T dominant.","accent":"#EA580C"},{"n":5,"heading":"Try this","body":"Homozygous = two identical alleles.","accent":"#DB2777"}]},{"grade":"G10","subject":"CHEMISTRY","unit_number":1,"title":"Atomic Structure and Periodicity","type":"illustrated_cards","slides":[{"n":1,"heading":"Configuration","body":"Electrons fill 1s, 2s, 2p, 3s…","accent":"#0D9488"},{"n":2,"heading":"Trends","body":"Radius decreases across period; IE generally increases.","accent":"#7C3AED"},{"n":3,"heading":"Valence","body":"Outer electrons determine bonding.","accent":"#0284C7"},{"n":4,"heading":"Worked idea","body":"Na: 1s²2s²2p⁶3s¹ → one valence electron.","accent":"#EA580C"},{"n":5,"heading":"Try this","body":"Noble gases have full outer shells.","accent":"#DB2777"}]},{"grade":"G10","subject":"CHEMISTRY","unit_number":2,"title":"Chemical Bonding and Structure","type":"illustrated_cards","slides":[{"n":1,"heading":"Ionic vs covalent","body":"Transfer vs share.","accent":"#0D9488"},{"n":2,"heading":"Lewis","body":"Dots show valence electrons.","accent":"#7C3AED"},{"n":3,"heading":"VSEPR","body":"Shapes: linear, bent, tetrahedral…","accent":"#0284C7"},{"n":4,"heading":"Worked idea","body":"H₂O bent; CO₂ linear.","accent":"#EA580C"},{"n":5,"heading":"Try this","body":"NH₃ trigonal pyramidal.","accent":"#DB2777"}]},{"grade":"G10","subject":"CHEMISTRY","unit_number":3,"title":"Stoichiometry","type":"illustrated_cards","slides":[{"n":1,"heading":"Mole","body":"1 mol = 6.02×10²³ particles.","accent":"#0D9488"},{"n":2,"heading":"Molar mass","body":"g/mol from periodic table.","accent":"#7C3AED"},{"n":3,"heading":"Limiting reactant","body":"Runs out first → limits product.","accent":"#0284C7"},{"n":4,"heading":"Worked idea","body":"2H₂+O₂→2H₂O; 4 mol H₂ need 2 mol O₂.","accent":"#EA580C"},{"n":5,"heading":"Try this","body":"Moles = mass / molar mass.","accent":"#DB2777"}]},{"grade":"G10","subject":"CHEMISTRY","unit_number":4,"title":"Acids, Bases and pH","type":"illustrated_cards","slides":[{"n":1,"heading":"Arrhenius","body":"Acid→H⁺; base→OH⁻ in water.","accent":"#0D9488"},{"n":2,"heading":"pH","body":"pH=−log[H⁺]. Acidic <7; basic >7.","accent":"#7C3AED"},{"n":3,"heading":"Neutralization","body":"Acid+base→salt+water.","accent":"#0284C7"},{"n":4,"heading":"Worked idea","body":"0.01 M HCl → pH=2.","accent":"#EA580C"},{"n":5,"heading":"Try this","body":"Strong acids fully ionize.","accent":"#DB2777"}]}]}
