{"grade":"G12","deck_count":10,"decks":[{"grade":"G12","subject":"MATH","unit_number":1,"title":"Calculus — Limits","type":"illustrated_cards","slides":[{"n":1,"heading":"Limit idea","body":"lim x→a f(x)=L means f approaches L as x approaches a.","accent":"#0D9488"},{"n":2,"heading":"Continuity","body":"lim x→a f(x)=f(a).","accent":"#7C3AED"},{"n":3,"heading":"Standard limits","body":"lim x→0 sin x/x = 1.","accent":"#0284C7"},{"n":4,"heading":"Worked idea","body":"lim x→2 (x²−4)/(x−2)=4.","accent":"#EA580C"},{"n":5,"heading":"Try this","body":"Polynomials are continuous everywhere.","accent":"#DB2777"}]},{"grade":"G12","subject":"MATH","unit_number":2,"title":"Differentiation","type":"illustrated_cards","slides":[{"n":1,"heading":"Definition","body":"f′(x)=lim h→0 [f(x+h)−f(x)]/h.","accent":"#0D9488"},{"n":2,"heading":"Power rule","body":"d/dx xⁿ = n xⁿ⁻¹.","accent":"#7C3AED"},{"n":3,"heading":"Chain rule","body":"(f∘g)′ = f′(g)·g′.","accent":"#0284C7"},{"n":4,"heading":"Worked idea","body":"d/dx x³ = 3x².","accent":"#EA580C"},{"n":5,"heading":"Try this","body":"d/dx sin x = cos x.","accent":"#DB2777"}]},{"grade":"G12","subject":"MATH","unit_number":3,"title":"Integration","type":"illustrated_cards","slides":[{"n":1,"heading":"Antiderivative","body":"∫ xⁿ dx = xⁿ⁺¹/(n+1) + C (n≠−1).","accent":"#0D9488"},{"n":2,"heading":"Definite integral","body":"Area under curve from a to b.","accent":"#7C3AED"},{"n":3,"heading":"FTC","body":"∫_a^b f = F(b)−F(a).","accent":"#0284C7"},{"n":4,"heading":"Worked idea","body":"∫₀¹ 2x dx = 1.","accent":"#EA580C"},{"n":5,"heading":"Try this","body":"∫ cos x dx = sin x + C.","accent":"#DB2777"}]},{"grade":"G12","subject":"MATH","unit_number":4,"title":"Probability and Statistics","type":"illustrated_cards","slides":[{"n":1,"heading":"Probability","body":"0 ≤ P ≤ 1; sum of outcomes = 1.","accent":"#0D9488"},{"n":2,"heading":"Mean/median","body":"Central tendency measures.","accent":"#7C3AED"},{"n":3,"heading":"Combinations","body":"C(n,k)=