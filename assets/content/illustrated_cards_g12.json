{"grade":"G12","deck_count":4,"decks":[{"grade":"G12","subject":"MATH","unit_number":1,"title":"Calculus — Limits","type":"illustrated_cards","slides":[{"n":1,"heading":"Limit idea","body":"lim x→a f(x) = L means f(x) approaches L as x approaches a.","accent":"#0D9488"},{"n":2,"heading":"One-sided limits","body":"Left and right limits must agree for the two-sided limit to exist.","accent":"#7C3AED"},{"n":3,"heading":"Continuity","body":"f is continuous at a if lim x→a f(x) = f(a).","accent":"#0284C7"},{"n":4,"heading":"Worked idea","body":"lim x→2 (x²−4)/(x−2) = lim (x+2) = 4 after cancelling.","accent":"#EA580C"},{"n":5,"heading":"Try this","body":"lim x→0 sin(x)/x = 1 (standard limit).","accent":"#DB2777"}]},{"grade":"G12","subject":"MATH","unit_number":2,"title":"Differentiation","type":"illustrated_cards","slides":[{"n":1,"heading":"Derivative","body":"f′(x) = lim h→0 [f(x+h)−f(x)]/h.","accent":"#0D9488"},{"n":2,"heading":"Power rule","body":"d/dx [xⁿ] = n xⁿ⁻¹.","accent":"#7C3AED"},{"n":3,"heading":"Product & chain","body":"(uv)′ = u′v+uv′; (f(g(x)))′ = f′(g(x))·g′(x).","accent":"#0284C7"},{"n":4,"heading":"Worked idea","body":"d/dx (x³) = 3x²; d/dx (sin x) = cos x.","accent":"#EA580C"},{"n":5,"heading":"Try this","body":"d/dx (5x²) = 10x.","accent":"#DB2777"}]},{"grade":"G12","subject":"PHYSICS","unit_number":1,"title":"Electricity","type":"illustrated_cards","slides":[{"n":1,"heading":"Current","body":"I = Q/t. Unit: ampere (A).","accent":"#0D9488"},{"n":2,"heading":"Ohm’s law","body":"V = IR for ohmic conductors.","accent":"#7C3AED"},{"n":3,"heading":"Power","body":"P = VI = I²R = V²/R.","accent":"#0284C7"},{"n":4,"heading":"Worked idea","body":"V=12 V, R=6 Ω → I=2 A; P=24 W.","accent":"#EA580C"},{"n":5,"heading":"Try this","body":"Series resistors: R_total = R1+R2.","accent":"#DB2777"}]},{"grade":"G12","subject":"CHEMISTRY","unit_number":1,"title":"Organic Chemistry Basics","type":"illustrated_cards","slides":[{"n":1,"heading":"Hydrocarbons","body":"Compounds of C and H only. Alkanes saturated; alkenes have C=C.","accent":"#0D9488"},{"n":2,"heading":"Functional groups","body":"Alcohol −OH; carboxylic acid −COOH; amine −NH₂.","accent":"#7C3AED"},{"n":3,"heading":"Isomers","body":"Same formula, different structure.","accent":"#0284C7"},{"n":4,"heading":"Worked idea","body":"C₂H₆ is ethane (alkane); C₂H₄ is ethene (alkene).","accent":"#EA580C"},{"n":5,"heading":"Try this","body":"General formula for alkanes: CₙH₂ₙ₊₂.","accent":"#DB2777"}]}]}
