{"grade":"G11","deck_count":12,"decks":[{"grade":"G11","subject":"MATH","unit_number":1,"title":"Functions and Graphs","type":"illustrated_cards","slides":[{"n":1,"heading":"Function review","body":"Each input maps to exactly one output.","accent":"#0D9488"},{"n":2,"heading":"Composite functions","body":"(f∘g)(x) = f(g(x)).","accent":"#7C3AED"},{"n":3,"heading":"Inverse idea","body":"f⁻¹ undoes f when f is one-to-one.","accent":"#0284C7"},{"n":4,"heading":"Worked idea","body":"If f(x)=2x+1, f⁻¹(x)=(x−1)/2.","accent":"#EA580C"},{"n":5,"heading":"Try this","body":"Domain of √(x−1) is x ≥ 1.","accent":"#DB2777"}]},{"grade":"G11","subject":"MATH","unit_number":2,"title":"Sequences and Series","type":"illustrated_cards","slides":[{"n":1,"heading":"Arithmetic sequence","body":"Common difference d. aₙ = a₁ + (n−1)d.","accent":"#0D9488"},{"n":2,"heading":"Geometric sequence","body":"Common ratio r. aₙ = a₁·rⁿ⁻¹.","accent":"#7C3AED"},{"n":3,"heading":"Sum formulas","body":"Arithmetic and geometric partial sums have closed forms.","accent":"#0284C7"},{"n":4,"heading":"Worked idea","body":"1,3,5,… a₁₀ = 1+9·2 = 19.","accent":"#EA580C"},{"n":5,"heading":"Try this","body":"Geometric 2,6,18,… r = 3.","accent":"#DB2777"}]},{"grade":"G11","subject":"MATH","unit_number":3,"title":"Trigonometry Advanced","type":"illustrated_cards","slides":[{"n":1,"heading":"Radians","body":"π rad = 180°. Full circle 2π.","accent":"#0D9488"},{"n":2,"heading":"Identities","body":"sin²θ+cos²θ=1; 1+tan²θ=sec²θ.","accent":"#7C3AED"},{"n":3,"heading":"Sine rule","body":"a/sin A = b/sin B = c/sin C.","accent":"#0284C7"},{"n":4,"heading":"Worked idea","body":"sin 30° = 1/2; cos 60° = 1/2.","accent":"#EA580C"},{"n":5,"heading":"Try this","body":"cos²θ = 1 − sin²θ.","accent":"#DB2777"}]},{"grade":"G11","subject":"PHYSICS","unit_number":1,"title":"Mechanics Review","type":"illustrated_cards","slides":[{"n":1,"heading":"Newton laws","body":"Inertia; F=ma; action–reaction.","accent":"#0D9488"},{"n":2,"heading":"