#!/bin/bash
export PATH="/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin:/usr/local/bin:$PATH"
HERE="$(cd "$(dirname "$0")" && pwd)"
ENGINE="$HERE/../Resources/FourLock.command"
LOG="$HOME/Library/Logs/FourLock.log"
mkdir -p "$(dirname "$LOG")" 2>/dev/null || true
echo "$(date) app-launch $ENGINE" >> "$LOG" 2>/dev/null || true

/usr/bin/osascript -e 'display dialog "Opening FourLock…" buttons {"OK"} default button "OK" with title "FourLock"' >/dev/null 2>>"$LOG" || true

if [ ! -f "$ENGINE" ]; then
  /usr/bin/osascript -e 'display dialog "FourLock.command is missing inside the app.\n\nUnzip FourLock.zip and double-click “Open FourLock.command” instead." buttons {"OK"} default button "OK" with title "FourLock"' >/dev/null 2>>"$LOG" || true
  exit 1
fi
/bin/chmod +x "$ENGINE" 2>/dev/null || true

if /usr/bin/open -a Terminal "$ENGINE"; then
  exit 0
fi
exec /bin/bash "$ENGINE"
